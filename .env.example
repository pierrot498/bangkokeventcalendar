# Public site (canonical URL, used for sitemap, OG tags, JSON-LD, ICS links)
NEXT_PUBLIC_SITE_URL=

# Supabase (same project as runclubbangkok; all tables prefixed bke_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: seed script + submission inserts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Daily jobs (scripts/run-job.ts)
# Shared secret for /api/revalidate (generate with: openssl rand -hex 32)
REVALIDATE_SECRET=
# Optional: Claude extraction for unstructured source pages (skipped when empty)
ANTHROPIC_API_KEY=
# Optional: max Claude calls per run (default 10)
JOBS_MAX_AI_CALLS=
